{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-keel.dev/schemas/rationale.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rationale_id", "rule_id", "pitfall", "mitigation", "limits", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "rationale_id": { "type": "string", "minLength": 3 },
    "rule_id": { "type": "string", "minLength": 3 },
    "previous_rationale_id": { "type": "string", "minLength": 3 },
    "pitfall": { "type": "string", "minLength": 1 },
    "mitigation": { "type": "string", "minLength": 1 },
    "limits": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
